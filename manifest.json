{
  "manifest_version": 2,
  "name": "Monitoramento de Privacidade",
  "version": "1.0.0",
  "description": "Detecta ameacas a privacidade e rastreamento na navegacao web.",

  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "cookies",
    "storage",
    "tabs",
    "activeTab",
    "<all_urls>"
  ],

  "background": {
    "scripts": ["privacy.js"],
    "persistent": true
  },

  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Monitoramento de Privacidade"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "privacy-monitor@insper.edu.br",
      "strict_min_version": "91.0",
      "data_collection_permissions": {
        "required": [],
        "optional": []
      }
    }
  }
}